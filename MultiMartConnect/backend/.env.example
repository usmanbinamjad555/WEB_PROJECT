# Backend environment variables (MultiMartConnect API)
# The backend does not load .env files itself (no dotenv); export these in
# your shell or process manager before running `npm run dev:api`.

# Required. Secret used to verify JWT access tokens (HTTP + Socket.IO).
# The server refuses to start if this is missing.
JWT_ACCESS_SECRET=replace-with-a-long-random-string

# MongoDB connection string. Defaults to mongodb://localhost:27017/multimart_db
# Must point to a replica set: order creation uses multi-document transactions.
MONGO_URI=mongodb://localhost:27017/multimart_db

# Comma-separated list of origins allowed by CORS and Socket.IO.
# Defaults to http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated list of Kafka brokers. Defaults to localhost:9092
KAFKA_BROKERS=localhost:9092

# "production" enables SSL for the Kafka client.
NODE_ENV=development

# Note: the HTTP port is fixed at 8000 in src/server.ts and the Redis cart
# client connects to the default redis://localhost:6379; neither is
# configurable through environment variables yet.
